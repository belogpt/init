#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=config/default.conf
. "${APP_DIR}/config/default.conf"
# shellcheck source=lib/logging.sh
. "${APP_DIR}/lib/logging.sh"
logging_init
# shellcheck source=lib/common.sh
. "${APP_DIR}/lib/common.sh"
# shellcheck source=lib/platform.sh
. "${APP_DIR}/lib/platform.sh"
# shellcheck source=lib/state.sh
. "${APP_DIR}/lib/state.sh"

trap 'init_error_trap ${LINENO} "$BASH_COMMAND"' ERR

usage() {
  cat <<'USAGE'
Usage: init [GLOBAL FLAGS] COMMAND [MODULE...] [OPTIONS]

Commands:
  help       Show help.             modules    List module registry.
  version    Show tool version.     check      Inspect selected modules.
  plan       Show selected plan.     apply      Apply selected modules.

Global flags:
  --target-user USER  User for git/ssh user-context modules.
  --no-color          Disable colored output.
  --debug             Enable debug logs.
  --yes, -y           Assume yes for package manager prompts.
  --upgrade           Run apt upgrade in packages module.
  --skip-upgrade      Deprecated no-op; upgrade is skipped by default.

Options:
  --git-name NAME       Configure target user's global git user.name.
  --git-email EMAIL     Configure target user's global git user.email.
  --ssh-key-path PATH   SSH private key path (default: ~/.ssh/id_ed25519).
  --ssh-key-comment TXT SSH key comment.
  --allow-http          Allow TCP port 80 in UFW.
  --allow-https         Allow TCP port 443 in UFW.
  --allow-port PORT/PROTO (1-65535 tcp|udp). Repeatable.
USAGE
}

is_command() { case "$1" in help|version|modules|check|plan|apply) return 0;; *) return 1;; esac; }
module_exists() { local m; for m in "${INIT_REGISTERED_MODULES[@]}"; do [ "$m" = "$1" ] && return 0; done; return 1; }

validate_port_rule() {
  [[ "$1" =~ ^([0-9]+)/(tcp|udp)$ ]] || { log_error "--allow-port must use PORT/PROTO, for example 8080/tcp or 53/udp"; return 2; }
  local port="${BASH_REMATCH[1]}"
  [ "${port}" -ge 1 ] && [ "${port}" -le 65535 ] || { log_error "--allow-port port must be in range 1-65535"; return 2; }
}

expect_value() { [ "$#" -ge 2 ] && [ -n "$2" ] && [[ "$2" != --* ]] || { log_error "$1 requires a value"; return 2; }; }

parse_args() {
  COMMAND=""; REQUESTED_MODULES=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-color) INIT_NO_COLOR=1; logging_init ;;
      --debug) INIT_DEBUG=1 ;;
      --yes|-y) ASSUME_YES=1 ;;
      --upgrade) UPGRADE=1 ;;
      --skip-upgrade) log_warn "--skip-upgrade is deprecated and is now a no-op; apt upgrade is skipped unless --upgrade is set" ;;
      --target-user) expect_value "$1" "${2:-}"; TARGET_USER="$2"; shift ;;
      --help) [ -z "${COMMAND}" ] || { log_error "Multiple commands specified: ${COMMAND} and help"; return 2; }; COMMAND=help ;;
      --check) [ -z "${COMMAND}" ] || { log_error "Multiple commands specified: ${COMMAND} and check"; return 2; }; COMMAND=check ;;
      --all) [ -z "${COMMAND}" ] || { log_error "Multiple commands specified: ${COMMAND} and apply"; return 2; }; COMMAND=apply ;;
      --git-name) expect_value "$1" "${2:-}"; GIT_NAME="$2"; shift ;;
      --git-email) expect_value "$1" "${2:-}"; GIT_EMAIL="$2"; shift ;;
      --ssh-key-path) expect_value "$1" "${2:-}"; SSH_KEY_PATH="$2"; shift ;;
      --ssh-key-comment) expect_value "$1" "${2:-}"; SSH_KEY_COMMENT="$2"; shift ;;
      --allow-http) ALLOW_HTTP=1 ;;
      --allow-https) ALLOW_HTTPS=1 ;;
      --allow-port) expect_value "$1" "${2:-}"; validate_port_rule "$2"; ALLOW_PORTS+=("$2"); shift ;;
      --*) log_error "Unknown command or option: $1"; return 2 ;;
      *)
        if is_command "$1"; then
          [ -z "${COMMAND}" ] || { log_error "Multiple commands specified: ${COMMAND} and $1"; return 2; }
          COMMAND="$1"
        else
          REQUESTED_MODULES+=("$1")
        fi
        ;;
    esac
    shift
  done
  if [ -z "${COMMAND}" ]; then
    if [ "${#REQUESTED_MODULES[@]}" -gt 0 ]; then log_error "Unknown command or option: ${REQUESTED_MODULES[0]}"; return 2; fi
    COMMAND="help"
  fi
}

load_modules() { local module; for module in "${INIT_REGISTERED_MODULES[@]}"; do . "${APP_DIR}/modules/${module}.sh"; done; }

resolve_modules() {
  RESOLVED_MODULES=(); local seen=" " input module dep
  local inputs=("${REQUESTED_MODULES[@]}")
  if [ "${#inputs[@]}" -eq 0 ]; then for module in "${INIT_REGISTERED_MODULES[@]}"; do [ "${INIT_MODULE_DEFAULTS[$module]}" = 1 ] && inputs+=("$module"); done; fi
  _add_module() {
    local m="$1" d
    module_exists "$m" || { log_error "Unknown module: $m"; return 2; }
    [[ "$seen" == *" $m "* ]] && return 0
    seen+="$m "
    for d in ${INIT_MODULE_DEPS[$m]}; do _add_module "$d"; done
    RESOLVED_MODULES+=("$m")
  }
  for input in "${inputs[@]}"; do _add_module "$input"; done
}

cmd_modules() { printf '%-12s %-8s %-18s %s\n' Module Default Dependencies Description; local m; for m in "${INIT_REGISTERED_MODULES[@]}"; do printf '%-12s %-8s %-18s %s\n' "$m" "${INIT_MODULE_DEFAULTS[$m]}" "${INIT_MODULE_DEPS[$m]:--}" "${INIT_MODULE_DESCRIPTIONS[$m]}"; done; }

run_modules() {
  local action="$1" module fn rc overall=0 statuses=()
  resolve_modules
  for module in "${RESOLVED_MODULES[@]}"; do
    fn="${module}_module_${action}"
    declare -F "${fn}" >/dev/null 2>&1 || { log_error "Module ${module} does not implement ${action}"; return 2; }
    trap - ERR; set +e; "${fn}"; rc=$?; set -e; trap 'init_error_trap ${LINENO} "$BASH_COMMAND"' ERR
    if [ "${action}" = check ]; then
      statuses+=("${module}:$(module_status_text "$rc")")
      if [ "$rc" -ge 2 ]; then overall=2; elif [ "$rc" -eq 1 ] && [ "$overall" -eq 0 ]; then overall=1; fi
    else
      statuses+=("${module}:done")
      [ "$rc" -eq 0 ] || overall="$rc"
    fi
  done
  printf '\n%-12s %s\n' Module Status
  for module in "${statuses[@]}"; do printf '%-12s %s\n' "${module%%:*}" "${module#*:}"; done
  return "$overall"
}

main() {
  set +e; parse_args "$@"; local rc=$?; set -e; [ "$rc" -eq 0 ] || return "$rc"
  load_modules
  set +e
  case "${COMMAND}" in
    help) usage ;;
    version) printf '%s\n' "${INIT_VERSION}" ;;
    modules) cmd_modules ;;
    check) run_modules check ;;
    plan) run_modules plan ;;
    apply) run_modules apply ;;
    *) log_error "Unknown command or option: ${COMMAND}"; rc=2 ;;
  esac
  rc=$?
  set -e
  return "$rc"
}

main "$@"
