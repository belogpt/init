#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=config/default.conf
. "${APP_DIR}/config/default.conf"
# shellcheck source=lib/logging.sh
. "${APP_DIR}/lib/logging.sh"
logging_init
# shellcheck source=lib/common.sh
. "${APP_DIR}/lib/common.sh"
# shellcheck source=lib/platform.sh
. "${APP_DIR}/lib/platform.sh"
# shellcheck source=lib/state.sh
. "${APP_DIR}/lib/state.sh"

trap 'init_error_trap ${LINENO} "$BASH_COMMAND"' ERR

usage() {
  cat <<'USAGE'
Usage: init [GLOBAL FLAGS] COMMAND [OPTIONS]

Modular VPS bootstrap tool for Ubuntu/Debian.

Commands:
  help       Show this help without changing the system.
  version    Show tool version.
  check      Inspect current state without changing the system.
  plan       Show planned changes without changing the system.
  apply      Apply the bootstrap plan idempotently.

Global flags:
  --no-color       Disable colored output.
  --debug          Enable debug logs.
  --yes, -y        Assume yes for package manager prompts.
  --skip-upgrade   Skip apt upgrade during apply.

Apply options:
  --git-name NAME       Configure global git user.name.
  --git-email EMAIL     Configure global git user.email.
  --ssh-key-path PATH   SSH private key path (default: ~/.ssh/id_ed25519).
  --ssh-key-comment TXT SSH key comment (default: server-<hostname>).
  --allow-http          Allow TCP port 80 in UFW.
  --allow-https         Allow TCP port 443 in UFW.
  --allow-port PORT/PROTO
                        Allow a custom UFW port rule. Repeatable.

Legacy bootstrap.sh flags are mapped where possible:
  --help -> help, --check -> check, --all -> apply.
USAGE
}

load_modules() {
  local module
  for module in "${INIT_MODULES[@]}"; do
    # shellcheck source=modules/system.sh
    . "${APP_DIR}/modules/${module}.sh"
  done
}

validate_port_rule() {
  if [[ ! "$1" =~ ^[0-9]+/(tcp|udp)$ ]]; then
    log_error "--allow-port must use PORT/PROTO, for example 8080/tcp or 53/udp"
    return 1
  fi
}

parse_args() {
  COMMAND=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-color) INIT_NO_COLOR=1; logging_init ;;
      --debug) INIT_DEBUG=1 ;;
      --yes|-y) ASSUME_YES=1 ;;
      --skip-upgrade) SKIP_UPGRADE=1 ;;
      --help) COMMAND="help" ;;
      --check) COMMAND="check" ;;
      --all) COMMAND="apply" ;;
      --docker|--git|--ssh-key|--firewall|--security)
        COMMAND="apply"
        log_warn "Legacy selector $1 is accepted, but init apply currently executes the system module plan."
        ;;
      help|version|check|plan|apply) COMMAND="$1" ;;
      --git-name) shift; [ "$#" -gt 0 ] || { log_error "--git-name requires a value"; return 1; }; GIT_NAME="$1" ;;
      --git-email) shift; [ "$#" -gt 0 ] || { log_error "--git-email requires a value"; return 1; }; GIT_EMAIL="$1" ;;
      --ssh-key-path) shift; [ "$#" -gt 0 ] || { log_error "--ssh-key-path requires a value"; return 1; }; SSH_KEY_PATH="$1" ;;
      --ssh-key-comment) shift; [ "$#" -gt 0 ] || { log_error "--ssh-key-comment requires a value"; return 1; }; SSH_KEY_COMMENT="$1" ;;
      --allow-http) ALLOW_HTTP=1 ;;
      --allow-https) ALLOW_HTTPS=1 ;;
      --allow-port) shift; [ "$#" -gt 0 ] || { log_error "--allow-port requires PORT/PROTO"; return 1; }; validate_port_rule "$1"; ALLOW_PORTS+=("$1") ;;
      *) log_error "Unknown command or option: $1"; return 2 ;;
    esac
    shift
  done
  COMMAND="${COMMAND:-help}"
}

run_modules() {
  local action="$1" module fn
  for module in "${INIT_MODULES[@]}"; do
    fn="${module}_module_${action}"
    if declare -F "${fn}" >/dev/null 2>&1; then
      "${fn}"
    else
      log_error "Module ${module} does not implement ${action}"
      return 1
    fi
  done
}

main() {
  parse_args "$@"
  load_modules
  case "${COMMAND}" in
    help) usage ;;
    version) printf '%s\n' "${INIT_VERSION}" ;;
    check) run_modules check ;;
    plan) run_modules plan ;;
    apply) run_modules apply ;;
    *) log_error "Unknown command: ${COMMAND}"; return 2 ;;
  esac
}

main "$@"
